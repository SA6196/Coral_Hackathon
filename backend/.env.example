# Coral Security Command Center — Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── GitHub Source ────────────────────────────────────────────────────
# Personal Access Token (needs repo + read:org scopes)
# Get it at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=owner/repo-name

# ─── Slack Source ─────────────────────────────────────────────────────
# Bot OAuth Token from your Slack App
# Get it at: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_CHANNEL=#security-alerts

# ─── Notion Source ────────────────────────────────────────────────────
# Integration Token from your Notion integration
# Get it at: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_token_here
NOTION_DATABASE_ID=your-database-id-here

# ─── OSV (Open Source Vulnerabilities) ───────────────────────────────
# OSV is a public API — no credentials required
# https://api.osv.dev/v1
OSV_API_URL=https://api.osv.dev/v1

# ─── AI/OpenAI (optional — enhances chat quality) ────────────────────
# Get it at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
